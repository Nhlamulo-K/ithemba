# Copy to .env and fill in real values. Never commit .env.

# Local PostgreSQL (docker compose)
POSTGRES_USER=ithemba
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ithemba
# Defaults are for running from your own machine. Inside Docker, use POSTGRES_HOST=postgres and POSTGRES_PORT=5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Only needed if you choose to use LocalStack (it now requires a free account and auth token)
LOCALSTACK_AUTH_TOKEN=
